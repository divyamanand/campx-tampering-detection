{
  "name": "campx-tampering-detection",
  "version": "1.0.0",
  "description": "CampX Tampering Detection",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n main,renderer,tsc \"electron .\" \"vite --config vite.config.ts\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.config.ts",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
     "@napi-rs/canvas": "^0.1.88",
    "@napi-rs/canvas-win32-x64-msvc": "^0.1.88",
    "pdf-to-img": "^5.0.0",
    "pdfjs-dist": "^5.4.530",
    "unpdf": "^1.4.0",
    "zxing-wasm": "^2.2.4"
  },
  "devDependencies": {
     "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
