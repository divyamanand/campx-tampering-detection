      "boundElements": [],
      "updated": 1770099015963,
      "link": null,
      "locked": false,
      "text": "A fixed directory\nOCR, OMR also can be options\nIf there is manual upload, collect the logs and reason\ncheck bio-attendance for electron app boilerplate\ninstead of checking all the pages, we can have a random check\nImages are available in PNG / JPG formats\nWrite for pros and cons for the tech you use.\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A fixed directory\nOCR, OMR also can be options\nIf there is manual upload, collect the logs and reason\ncheck bio-attendance for electron app boilerplate\ninstead of checking all the pages, we can have a random check\nImages are available in PNG / JPG formats\nWrite for pros and cons for the tech you use.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
