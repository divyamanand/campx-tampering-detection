    {
      "id": "-eS1wzrlgC8inMaNJDHEM",
      "type": "text",
      "x": -685.3321090166214,
      "y": 913.0429599106953,
      "width": 1047.0997314453125,
      "height": 359.9329720826656,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 565922980,
      "version": 1666,
      "versionNonce": 1587576220,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769810990685,
      "link": null,
      "locked": false,
      "text": "1. Pre processing before scanning\n    File already in DB -> Option to overwrite\n    File does not belongs to date/time slot -> Validation Error\n\n2. Start Scan\n    Auto Retry On\n        Retries 2-3 times -> retry disabled for the file -> needs attention\n    Auto Retry Off\n        Scan fails -> retry button -> if tried (2-3 times) -> retry disabled for the file -> needs attention\n    \nIf QR detection failed -> option to retry\nIf tampering detected -> stop scan -> throw error-> mention the error on hover of card\npage count is less/more than expected, QR codes are damaged, code mismatch (tampering)\nEach card should have option to remove the file",
      "fontSize": 20.567598404723746,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Pre processing before scanning\n    File already in DB -> Option to overwrite\n    File does not belongs to date/time slot -> Validation Error\n\n2. Start Scan\n    Auto Retry On\n        Retries 2-3 times -> retry disabled for the file -> needs attention\n    Auto Retry Off\n        Scan fails -> retry button -> if tried (2-3 times) -> retry disabled for the file -> needs attention\n    \nIf QR detection failed -> option to retry\nIf tampering detected -> stop scan -> throw error-> mention the error on hover of card\npage count is less/more than expected, QR codes are damaged, code mismatch (tampering)\nEach card should have option to remove the file",
      "autoResize": true,
      "lineHeight": 1.25
    },
