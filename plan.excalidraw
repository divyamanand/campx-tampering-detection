      "boundElements": [],
      "updated": 1769810990685,
      "link": null,
      "locked": false,
      "text": "Select Exam, Time Slot\nThen option to upload the sheets\nkeep track of folder, scan in batches\nrun the scan \nstore logs for our use in DB\nretry on failure (2 times) \noption for Rescan and upload\n(popup)\nif fails after rescanning contact admin\nkeep deleting records from memory\nfor successful attempts.\nduring upload\nscan simultaneously but upload on DB,\none or two together.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Select Exam, Time Slot\nThen option to upload the sheets\nkeep track of folder, scan in batches\nrun the scan \nstore logs for our use in DB\nretry on failure (2 times) \noption for Rescan and upload\n(popup)\nif fails after rescanning contact admin\nkeep deleting records from memory\nfor successful attempts.\nduring upload\nscan simultaneously but upload on DB,\none or two together.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
