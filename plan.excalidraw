    {
      "id": "PnzvE8QatSUpbIUA1TRI7",
      "type": "text",
      "x": 2183.091794663169,
      "y": -541.6858972956072,
      "width": 499.85968017578125,
      "height": 475,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 40760996,
      "version": 726,
      "versionNonce": 1629788316,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769810990685,
      "link": null,
      "locked": false,
      "text": "Scan all the files in one go in batches\nOnly two attempts -> real image and rotated image\nstore the best result of two\n\nThe files will be scanned and logs will be collected\nin the local system\n\nThe system will use those logs to track\nundetected codes and files\n\nFallback Mechanism via OCR\n    Either require Coordinate based location or\n    LLM to parse the OCR text\n\nBacktrack retry mechanism\n    need to group files subject wise\n    better to have the known booklet template \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scan all the files in one go in batches\nOnly two attempts -> real image and rotated image\nstore the best result of two\n\nThe files will be scanned and logs will be collected\nin the local system\n\nThe system will use those logs to track\nundetected codes and files\n\nFallback Mechanism via OCR\n    Either require Coordinate based location or\n    LLM to parse the OCR text\n\nBacktrack retry mechanism\n    need to group files subject wise\n    better to have the known booklet template \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "REWoyvZLe4L9M2V2LBgCO",
      "type": "text",
      "x": 1199.2110044559217,
      "y": -681.2753948916334,
      "width": 533.7796630859375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 641696292,
      "version": 367,
      "versionNonce": 595840804,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769810990685,
      "link": null,
      "locked": false,
      "text": "PROS: High accuracy, strong retry mechanism\nCONS: Takes very long time. Still may miss some codes,\n        some fallback mechanism can should be preferred",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PROS: High accuracy, strong retry mechanism\nCONS: Takes very long time. Still may miss some codes,\n        some fallback mechanism can should be preferred",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1yhFQPlsGPGO0VOMYB211",
      "type": "text",
      "x": 2193.2232924059117,
      "y": -657.635240054866,
      "width": 411.959716796875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 2127797668,
      "version": 162,
      "versionNonce": 582952220,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769810990685,
      "link": null,
      "locked": false,
      "text": "PROS: Upto 10x faster that V1\nCONS: May some codes remain undetected,\n        requires fallback / backtracking ",
