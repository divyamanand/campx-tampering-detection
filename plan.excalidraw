    {
      "id": "Y-YXOmlzxGJnbyS2pkkaS",
      "type": "text",
      "x": 1151.6988085145313,
      "y": -442.3349664609391,
      "width": 723.3995361328125,
      "height": 475,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1075980068,
      "version": 1096,
      "versionNonce": 1155578276,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769810990685,
      "link": null,
      "locked": false,
      "text": "For each file, For each page\n    convert page to image at a default scale (PDF to Image)\n    scanImage and get the result\n    if pass -> store in allPdfFiles {fileName: {pageNumber: {result, scale, }}\n    else -> retry with same img once again\n            if pass -> store\n            else -> while keep failing\n                        -> increase scale by 1 \n                        -> decrease by 1\n                        -> increase by 1\n                        -> decrease by 1\n Eg -> for a scale of 3\n on failure -> retry at 3 (rotate the image once by 180 degrees)\n    then retry at 4 and 2\n    then retry at 5 and 1\n    then retry at 6 and 0 (<= 0 so ignore the try)\n    then retry at 7 and -1 (<= 0 so ignore the try)\n    \nif fails after a scale of 9 then surrender.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For each file, For each page\n    convert page to image at a default scale (PDF to Image)\n    scanImage and get the result\n    if pass -> store in allPdfFiles {fileName: {pageNumber: {result, scale, }}\n    else -> retry with same img once again\n            if pass -> store\n            else -> while keep failing\n                        -> increase scale by 1 \n                        -> decrease by 1\n                        -> increase by 1\n                        -> decrease by 1\n Eg -> for a scale of 3\n on failure -> retry at 3 (rotate the image once by 180 degrees)\n    then retry at 4 and 2\n    then retry at 5 and 1\n    then retry at 6 and 0 (<= 0 so ignore the try)\n    then retry at 7 and -1 (<= 0 so ignore the try)\n    \nif fails after a scale of 9 then surrender.",
      "autoResize": true,
      "lineHeight": 1.25
    },
